{
  "max_lines": 300,
  "max_files_per_dir": 12,
  "max_lines_overrides": {
    "src/core/core_messages_v2.cpp": 600,
    "bindings/rust/yunlink/src/v2.rs": 560,
    "bindings/python/src/yunlink/v2.py": 520,
    "src/discovery/discovery_v2.cpp": 440,
    "src/runtime/v2/runtime.cpp": 340,
    "src/core/wire_v2_codec.cpp": 340
  },
  "include_exts": ["c", "cc", "cpp", "cxx", "h", "hh", "hpp", "py", "rs"],
  "scan_roots": [
    "include",
    "src",
    "bindings/rust",
    "bindings/python/src",
    "tools"
  ],
  "exclude_dirs": [
    ".git",
    ".hg",
    ".svn",
    ".venv",
    "venv",
    "node_modules",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    "target",
    "build",
    "dist",
    "thirdparty"
  ],
  "exclude_globs": []
}
