@startuml
!include _yunlink_protocol_theme.iuml
title yunlink_ros_bridge - Current Component View

package "yunlink_ros_bridge" <<Neutral>> {
  component "Runtime / Session" as RuntimeSession <<Control>>
  component "Endpoint Discovery" as Discovery <<Neutral>>
  component "Command Mapping" as Commands <<Control>>
  component "Topic Snapshot Mapping" as Topics <<StatePlane>>
  component "System Service Worker" as SystemServices <<Neutral>>
  component "Diagnostics / TUI" as Diagnostics <<StatePlane>>
}

package "Sunray ROS Contract" <<Neutral>> {
  component "local_odom / odom_state" as Odom <<StatePlane>>
  component "px4_state" as Px4 <<StatePlane>>
  component "control_cmd / control_state" as Control <<Control>>
  component "command_execution_status" as Execution <<StatePlane>>
  component "feature services" as Features <<Neutral>>
}

package "yunlink::Runtime" <<Control>> {
  component "default kAutoResult" as AutoResult <<Control>>
  component "typed command subscribers" as RuntimeSub <<Control>>
  component "snapshot publishers" as SnapshotPub <<StatePlane>>
  component "system-service pub/sub" as ServicePubSub <<Neutral>>
}

RuntimeSession --> AutoResult
RuntimeSession --> Discovery
RuntimeSub --> Commands
Commands --> Control : publish UAVControlCMD
Odom --> Topics
Px4 --> Topics
Control --> Topics
Execution --> Topics
Topics --> SnapshotPub
ServicePubSub --> SystemServices
SystemServices <--> Features
Diagnostics ..> RuntimeSession
Diagnostics ..> Topics
Diagnostics ..> Commands

note right of AutoResult
没有 command tracker，
没有显式执行结果回包。
end note
@enduml
