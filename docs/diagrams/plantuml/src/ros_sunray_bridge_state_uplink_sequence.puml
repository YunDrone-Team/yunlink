@startuml
!include _yunlink_protocol_theme.iuml
title Current State Uplink Sequence

participant "Sunray ROS topic" as ROS
participant "yunlink_ros_bridge" as BRIDGE
participant "yunlink::Runtime" as RT
participant "Ground Client" as GROUND

ROS -> BRIDGE : topic callback with current message
BRIDGE -> BRIDGE : apply per-channel publish_hz limit
alt throttled
  BRIDGE -> BRIDGE : skip this message
else eligible
  BRIDGE -> BRIDGE : ensure active peer session
  alt no active session
    BRIDGE -> BRIDGE : do not publish snapshot
  else session active
    BRIDGE -> BRIDGE : map current ROS message
    BRIDGE -> RT : publish typed snapshot\ntarget=GroundStation broadcast
    RT -> GROUND : route snapshot on active session
  end
end

note bottom
bridge 不缓存并重复发送旧状态，
也不生成 heartbeat。
end note
@enduml
